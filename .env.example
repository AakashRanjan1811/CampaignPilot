# LLM strategist: mock (offline), groq, or ollama
LLM_PROVIDER=mock

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local): ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Policy
CAMPAIGN_BUDGET=250
MAX_DISCOUNT_PCT=30
VIP_MAX_DISCOUNT_PCT=10
FREQUENCY_CAP_DAYS=7
GROSS_MARGIN=0.45
MAX_REVISIONS=2
